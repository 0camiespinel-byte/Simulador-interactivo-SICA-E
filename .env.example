# Base de datos MySQL externa (obligatoria en Vercel)
DB_HOST=tu-host-mysql
DB_PORT=3306
DB_NAME=sica_e
DB_USER=tu-usuario
DB_PASSWORD=tu-clave
DB_CHARSET=utf8mb4

# Opcional: usa un DSN completo y reemplaza las variables DB_* anteriores.
# DB_DSN=mysql:host=tu-host;port=3306;dbname=sica_e;charset=utf8mb4

# Déjalo en false después de importar database/schema.sql.
DB_AUTO_INIT=false

# Normalmente debe quedarse vacío porque Vercel sirve el dominio desde la raíz.
APP_BASE_PATH=

# Opcional. /tmp no es almacenamiento permanente en Vercel.
# SESSION_SAVE_PATH=/tmp/sica-e-sessions
# UPLOADS_PATH=/tmp/sica-e-uploads